{
  "schemaVersion": 1,
  "id": "menumod",
  "version": "${version}",
  "name": "Mod Menu",
  "description": "Jedno menu na wszystko: moduły, własny HUD, profil i ustawienia w zaokrąglonym stylu. Naciśnij Prawy Shift i ustaw grę po swojemu.",
  "authors": ["mikolajsk874-bot"],
  "license": "MIT",
  "icon": "assets/menumod/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["com.example.menumod.MenuModClient"]
  },
  "mixins": [
    {
      "config": "menumod.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
